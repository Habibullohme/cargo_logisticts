# Bu faylni nusxalang:  cp .env.example .env
# Keyin .env ichidagi qiymatlarni o'zgartiring. .env gitga TUSHMAYDI.

# --- Baza (PostgreSQL) ---
POSTGRES_USER=yuk
POSTGRES_PASSWORD=yuk_parol_ozgartiring
POSTGRES_DB=yuk

# --- Backend ---
APP_ENV=development
# Docker ichida baza "db" nomi bilan topiladi.
DATABASE_URL=postgresql+asyncpg://yuk:yuk_parol_ozgartiring@db:5432/yuk
CORS_ORIGINS=http://localhost:3000

# --- Telegram bot ---
# @BotFather dan olingan token
BOT_TOKEN=
# Bot backendga shu kalit bilan murojaat qiladi (1-bosqichdan). Tasodifiy uzun matn qo'ying:
#   openssl rand -hex 32
BOT_API_KEY=
# Birinchi admin — sizning Telegram ID raqamingiz (@userinfobot dan bilib olasiz)
FIRST_ADMIN_TELEGRAM_ID=
